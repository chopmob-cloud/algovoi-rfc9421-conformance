*.pyc
node_modules/
runners/typescript/package-lock.json
.DS_Store

# runner build artifacts (deps fetched in CI / locally, never committed)
runners/**/libs/
*.class
*.jar
runners/dotnet/bin/
runners/dotnet/obj/
runners/dotnet-wba/bin/
runners/dotnet-wba/obj/
runners/elixir/_build/
runners/elixir/deps/

# KAF cell artifacts: sealed receipts + the public key are committed; the raw
# per-run results and any seal secret are not.
kaf/cells.results.json
kaf/cells_wba.results.json
kaf/**/*.secret

# C runner build artifacts
runners/c/negative_v1
runners/c/*.o

# Scala runner build artifacts
runners/scala/.scala-build/

# rust runner build artifacts
runners/rust/target/
runners/rust-wba/target/
