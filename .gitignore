__pycache__/
*.pyc
node_modules/
runners/typescript/package-lock.json
.DS_Store

# runner build artifacts (deps fetched in CI / locally, never committed)
runners/**/libs/
*.class
*.jar
runners/dotnet/bin/
runners/dotnet/obj/
runners/dotnet-wba/bin/
runners/dotnet-wba/obj/
runners/dotnet-fapi/bin/
runners/dotnet-fapi/obj/
runners/elixir/_build/
runners/elixir/deps/

# KAF cell artifacts: sealed receipts + the public key are committed; the raw
# per-run results and any seal secret are not.
kaf/cells.results.json
kaf/cells_wba.results.json
kaf/cells_fapi.results.json
kaf/**/*.secret

# C runner build artifacts
runners/c/negative_v1
runners/c/*.o

# Scala runner build artifacts
runners/scala/.scala-build/

# rust runner build artifacts
runners/rust/target/
runners/rust-wba/target/
runners/rust-fapi/target/
runners/rust-sfv/target/
runners/rust-jws/target/

# sfv_v0 / jws_v0 runner + cell artifacts (built in CI / cells, never committed;
# only the sealed receipts under kaf/receipts/ are committed)
runners/dotnet-sfv/bin/
runners/dotnet-sfv/obj/
runners/dotnet-jws/bin/
runners/dotnet-jws/obj/
runners/c/verify_sfv
runners/c/verify_jws
kaf/cells_sfv.results.json
kaf/cells_jws.results.json
