      "signature_params_raw": "(\"@authority\" \"@method\" \"signature-agent\");created=5000;expires=6000;keyid=\"58ujjb9U1hRhxX0aQe4uiHLkD50l754SxJ1EpF-2WTI\";alg=\"ed25519\";tag=\"web-bot-auth\"",
      "signing_base_b64": "",
      "ok": true,
      "note": "same profile, different created/expires window"
