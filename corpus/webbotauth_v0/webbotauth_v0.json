  "wba_freshness": [
    {
      "created": 1000,
      "expires": 2000,
      "now": 1500,
      "expect_accept": true,
      "reason": "ok",
      "note": "inside the validity window"
    },
    {
      "created": 1000,
      "expires": 2000,
      "now": 1000,
      "expect_accept": true,
      "reason": "ok",
      "note": "boundary: now == created (valid)"
    },
    {
      "created": 1000,
      "expires": 2000,
      "now": 1999,
      "expect_accept": true,
      "reason": "ok",
      "note": "boundary: last valid second"
    },
    {
      "created": 1000,
      "expires": 2000,
      "now": 2000,
      "expect_accept": false,
      "reason": "expired",
      "note": "boundary: now == expires (expired)"
    },
    {
      "created": 1000,
      "expires": 2000,
      "now": 2500,
      "expect_accept": false,
      "reason": "expired",
      "note": "past expiry"
    },
    {
      "created": 1000,
      "expires": 2000,
      "now": 900,
      "expect_accept": false,
      "reason": "not_yet_valid",
      "note": "before created (not yet valid)"
    },
    {
      "created": 2000,
      "expires": 1000,
      "now": 1500,
      "expect_accept": false,
      "reason": "expires_not_after_created",
      "note": "expires not after created (malformed window)"
    }
  ],
