      "required": [
        "@authority",
        "signature-agent"
      ],
      "expect_accept": false,
      "reason": "missing_required_covered_component:@authority",
      "note": "missing @authority (cross-origin replay)"
    },
    {
      "covered_components": [
        "@authority",
        "@method"
      ],
      "required": [
        "@authority",
        "signature-agent"
      ],
      "expect_accept": false,
