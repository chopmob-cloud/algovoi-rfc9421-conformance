{
  "name": "jws_v0",
  "description": "Signed cross-language conformance battery for JSON Web Signature (RFC 7515) with the RFC 7518 RS256 / ES256 and RFC 8037 EdDSA algorithms: compact-serialization parsing, and the JOSE security rejections that lenient verifiers get wrong (alg:none, key/alg confusion such as HS256 keyed with an RSA public key, unknown crit, kid selection), plus the RS256 / ES256 / EdDSA signature verdicts. This is the JOSE sign/verify stage of the signing-flow bridge, the JWS sibling of the RFC 9421 HTTP Message Signatures corpora.",
  "profile": "json-web-signature",
  "policy": {
    "specs": [
      "RFC7515",
      "RFC7518",
      "RFC8037"
    ],
    "algorithms": [
      "RS256",
      "ES256",
      "EdDSA"
    ],
    "compact_signing_input": "ASCII(BASE64URL(protected)) + '.' + ASCII(BASE64URL(payload))",
    "security_rules": [
      "alg:none is always rejected",
      "header alg must match the held key type (key/alg confusion rejected)",
      "an unknown or unsupported crit parameter is rejected",
      "a kid that selects no held key is rejected"
    ],
    "low_s": "NOT enforced. Plain JOSE (RFC 7518 Section 3.4) permits a high-s ECDSA signature; low-s is a FAPI profile rule (fapi_messagesigning_v0), not a JWS rule, so it is deliberately out of jws_v0 scope.",
    "documented_divergences": []
  },
