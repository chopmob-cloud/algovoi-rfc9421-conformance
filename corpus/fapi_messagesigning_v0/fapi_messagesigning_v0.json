  "fapi_required_coverage": [
    {
      "message_type": "request",
      "covered_components": [
        "@method",
        "@target-uri",
        "authorization",
        "content-digest"
      ],
      "expect_accept": true,
      "reason": "ok",
      "note": "request covers the full mandated set"
    },
    {
      "message_type": "request",
      "covered_components": [
        "@method",
        "@target-uri",
        "content-digest"
      ],
      "expect_accept": false,
      "reason": "missing_required_covered_component:authorization",
      "note": "request omits authorization (access token unbound)"
    },
    {
      "message_type": "request",
      "covered_components": [
        "@method",
        "@target-uri",
        "authorization"
      ],
      "expect_accept": false,
      "reason": "missing_required_covered_component:content-digest",
      "note": "request omits content-digest (body unbound)"
    },
    {
      "message_type": "request",
      "covered_components": [
        "@target-uri",
        "authorization",
        "content-digest"
      ],
      "expect_accept": false,
      "reason": "missing_required_covered_component:@method",
      "note": "request omits @method"
    },
    {
      "message_type": "response",
      "covered_components": [
        "@status",
        "content-digest"
      ],
      "expect_accept": true,
      "reason": "ok",
      "note": "response covers the mandated set"
    },
    {
      "message_type": "response",
      "covered_components": [
        "@status"
      ],
      "expect_accept": false,
      "reason": "missing_required_covered_component:content-digest",
      "note": "response omits content-digest (body unbound)"
    }
  ],
